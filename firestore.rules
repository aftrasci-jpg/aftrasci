rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ================= PRODUCTS ================= */

    match /products/{productId} {

      // Lecture publique seulement pour produits visibles
      allow read: if resource.data.visible == true ||
                   (request.auth != null && request.auth.token.admin == true);
      
      // Autoriser les listes avec orderBy
      allow list: if true;

      // Création produit (admin uniquement)
      allow create: if request.auth != null
                    && request.auth.token.admin == true
                    && validateProductData(request.resource.data);

      // Modification produit
      allow update: if request.auth != null
                    && request.auth.token.admin == true
                    && validateProductUpdate(request.resource.data, resource.data);

      // Suppression produit
      allow delete: if request.auth != null
                    && request.auth.token.admin == true
                    && (!resource.data.featured ||
                        request.auth.token.superAdmin == true);
    }


    /* ================= CATEGORIES ================= */

    match /categories/{categoryId} {

      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.token.admin == true
                    && validateCategoryData(request.resource.data);

      allow update: if request.auth != null
                    && request.auth.token.admin == true
                    && validateCategoryUpdate(request.resource.data, resource.data);

      allow delete: if request.auth != null
                    && request.auth.token.admin == true;
    }


    /* ================= ADMINS ================= */

    match /admins/{adminId} {

      allow read, write: if request.auth != null
                         && request.auth.token.admin == true
                         && (request.auth.uid == adminId ||
                             request.auth.token.superAdmin == true);
    }


    /* ================= AUDIT LOGS ================= */

    match /auditLogs/{logId} {

      allow read: if request.auth != null
                  && request.auth.token.admin == true;

      allow create: if request.auth != null
                    && request.auth.token.admin == true
                    && validateAuditLog(request.resource.data);

      allow update, delete: if false;
    }
  }
}


/* ================= PRODUCT VALIDATION ================= */

function validateProductData(data) {

  return data.keys().hasOnly([
    'name',
    'category',
    'subcategory',
    'shortDescription',
    'detailedDescription',
    'mainImage',
    'images',
    'visible',
    'featured',
    'createdAt',
    'updatedAt'
  ]) &&

  data.name is string &&
  data.name.size() > 0 &&
  data.name.size() <= 200 &&

  data.category is string &&
  data.category.size() > 0 &&

  data.subcategory is string &&

  data.shortDescription is string &&
  data.shortDescription.size() > 0 &&
  data.shortDescription.size() <= 500 &&

  data.detailedDescription is string &&
  data.detailedDescription.size() > 0 &&
  data.detailedDescription.size() <= 5000 &&

  data.mainImage is string &&
  data.mainImage.matches('^https://.*\\.(jpg|jpeg|png|webp|gif)(\\?.*)?$') &&

  data.visible is bool &&
  data.featured is bool &&

  data.createdAt is timestamp &&
  data.updatedAt is timestamp &&

  data.createdAt <= request.time &&
  data.updatedAt <= request.time &&

  (
    data.images is list
    ? data.images.size() <= 10
    : true
  ) &&

  !data.name.matches('(?i)<script|javascript:|<iframe|<object|<embed') &&
  !data.shortDescription.matches('(?i)<script|javascript:|<iframe|<object|<embed') &&
  !data.detailedDescription.matches('(?i)<script|javascript:|<iframe|<object|<embed');
}


/* ================= PRODUCT UPDATE ================= */

function validateProductUpdate(newData, oldData) {

  return newData.keys().hasOnly([
    'name',
    'category',
    'subcategory',
    'shortDescription',
    'detailedDescription',
    'mainImage',
    'images',
    'visible',
    'featured',
    'createdAt',
    'updatedAt'
  ]) &&

  newData.name is string &&
  newData.name.size() > 0 &&
  newData.name.size() <= 200 &&

  newData.category is string &&
  newData.category.size() > 0 &&

  newData.subcategory is string &&

  newData.shortDescription is string &&
  newData.shortDescription.size() > 0 &&
  newData.shortDescription.size() <= 500 &&

  newData.detailedDescription is string &&
  newData.detailedDescription.size() > 0 &&
  newData.detailedDescription.size() <= 5000 &&

  newData.mainImage is string &&
  newData.mainImage.matches('^https://.*\\.(jpg|jpeg|png|webp|gif)(\\?.*)?$') &&

  newData.visible is bool &&
  newData.featured is bool &&

  newData.updatedAt is timestamp &&
  newData.updatedAt > oldData.updatedAt &&

  newData.createdAt == oldData.createdAt &&

  !newData.name.matches('(?i)<script|javascript:|<iframe|<object|<embed') &&
  !newData.shortDescription.matches('(?i)<script|javascript:|<iframe|<object|<embed') &&
  !newData.detailedDescription.matches('(?i)<script|javascript:|<iframe|<object|<embed');
}


/* ================= CATEGORY VALIDATION ================= */

function validateCategoryData(data) {

  return data.keys().hasOnly([
    'name',
    'description',
    'parentId',
    'createdAt',
    'updatedAt'
  ]) &&

  data.name is string &&
  data.name.size() > 0 &&
  data.name.size() <= 100 &&

  data.description is string &&
  data.description.size() > 0 &&
  data.description.size() <= 500 &&

  data.createdAt is timestamp &&
  data.updatedAt is timestamp &&

  data.createdAt <= request.time &&
  data.updatedAt <= request.time &&

  (
    data.parentId is string
    ? data.parentId.size() > 0
    : true
  ) &&

  !data.name.matches('(?i)<script|javascript:|<iframe|<object|<embed') &&
  !data.description.matches('(?i)<script|javascript:|<iframe|<object|<embed');
}


/* ================= CATEGORY UPDATE ================= */

function validateCategoryUpdate(newData, oldData) {

  return newData.keys().hasOnly([
    'name',
    'description',
    'parentId',
    'createdAt',
    'updatedAt'
  ]) &&

  newData.name is string &&
  newData.name.size() > 0 &&
  newData.name.size() <= 100 &&

  newData.description is string &&
  newData.description.size() > 0 &&
  newData.description.size() <= 500 &&

  newData.updatedAt is timestamp &&
  newData.updatedAt > oldData.updatedAt &&

  newData.createdAt == oldData.createdAt &&

  !newData.name.matches('(?i)<script|javascript:|<iframe|<object|<embed') &&
  !newData.description.matches('(?i)<script|javascript:|<iframe|<object|<embed');
}


/* ================= AUDIT LOG VALIDATION ================= */

function validateAuditLog(data) {

  return data.keys().hasOnly([
    'action',
    'userId',
    'timestamp',
    'details'
  ]) &&

  data.action is string &&
  data.action.size() > 0 &&
  data.action.size() <= 100 &&

  data.userId is string &&
  data.userId.size() > 0 &&

  data.timestamp is timestamp &&
  data.timestamp == request.time &&

  data.details is map &&
  data.details.keys().size() <= 20;
}